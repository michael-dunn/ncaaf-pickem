# Normalize line endings. .editorconfig declares CRLF for working-tree files and
# `dotnet format` enforces it, so the repo stores LF and checks out CRLF on Windows.
* text=auto

*.cs      text diff=csharp
*.razor   text
*.csproj  text
*.props   text
*.targets text
*.slnx    text
*.sln     text eol=crlf
*.json    text
*.md      text
*.css     text
*.js      text
*.html    text
*.ps1     text eol=crlf
*.sql     text

# Container / Linux deployment files (P8-05). These are read by a Linux shell or by the Docker
# daemon, so they must keep LF even when checked out on Windows - a CRLF shebang line makes
# `./backup.sh` fail with "bad interpreter".
*.sh           text eol=lf
*.yaml         text eol=lf
*.yml          text eol=lf
Dockerfile     text eol=lf
.dockerignore  text eol=lf
# Compose's env-file parser keeps a trailing \r inside the value, which would silently corrupt
# SA_PASSWORD and friends, so this one is LF everywhere too.
.env.example   text eol=lf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff  binary
*.woff2 binary
*.pdf  binary
*.wasm binary
