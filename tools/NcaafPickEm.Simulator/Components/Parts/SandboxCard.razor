@inherits SessionComponent
@* One click to a playable league. Shown open when the season has no league yet; afterwards it
   collapses to "add another league" and "wipe". *@

<section class="card @(HasLeagues ? string.Empty : "hero")">
    <div class="card-head">
        <h2>@(HasLeagues ? "Sandbox" : "Start a sandbox")</h2>
        @if (HasLeagues)
        {
            <button class="btn link" @onclick="() => _open = !_open">@(_open ? "hide" : "add another league / wipe")</button>
        }
    </div>

    @if (!HasLeagues)
    {
        <p class="muted">
            Creates the teams, a calendar with the week you choose current <em>from right now</em>, a slate whose first
            kickoff (the lock) is minutes away, you as commissioner, the players joined through real invites, default rules,
            and the week's set generated by the app's own Sunday job. Then open the app and play.
        </p>
    }

    @if (!HasLeagues || _open)
    {
        <div class="form-grid">
            <label>League <input @bind="_league" /></label>
            <label>You (commissioner) <input @bind="_tester" /></label>
            <label class="wide">Other players (comma separated) <input @bind="_players" /></label>
            <label>Start on week <input type="number" min="1" max="14" class="num" @bind="_startWeek" /></label>
            <label>Lock in (minutes) <input type="number" min="1" class="num" @bind="_lockIn" /></label>
            <label>Game length (minutes) <input type="number" min="1" class="num" @bind="_gameMinutes" /></label>
            <label>Conference rule
                <select @bind="_conference">
                    @foreach (string conference in Conferences)
                    {
                        <option value="@conference">@conference</option>
                    }
                </select>
            </label>
            <label class="check"><input type="checkbox" @bind="_autoPlay" /> Autoplay games</label>
        </div>
        <div class="btn-row">
            <button class="btn primary" disabled="@Busy" @onclick="CreateAsync">@(HasLeagues ? "Add this league" : "Create sandbox")</button>
            @if (HasLeagues)
            {
                <button class="btn danger" disabled="@Busy" @onclick="WipeAsync">@(_confirmWipe ? "Really wipe everything?" : "Wipe everything")</button>
                <span class="muted small">Wipe keeps the players (and their push subscriptions); everything else goes.</span>
            }
        </div>
    }
</section>

@code {
    private static readonly string[] Conferences = ["SEC", "B1G", "ACC", "B12", "PAC", "AAC", "SBC", "MWC", "MAC", "CUSA"];

    private bool _open;
    private bool _confirmWipe;
    private string _league = "Sim League";
    private string _tester = "Michael";
    private string _players = string.Join(", ", SandboxRequest.DefaultPlayers);
    private int _startWeek = 1;
    private int _lockIn = 15;
    private int _gameMinutes = SimState.DefaultGameMinutes;
    private string _conference = "SEC";
    private bool _autoPlay = true;

    private bool HasLeagues => Snapshot is { Leagues.Count: > 0 };

    private Task CreateAsync()
    {
        string[] players = [.. _players.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)];
        var request = new SandboxRequest(
            _league.Trim(),
            _tester.Trim(),
            players,
            _startWeek,
            _conference,
            _lockIn,
            _gameMinutes,
            _autoPlay,
            Snapshot?.Settings.Slate);

        _open = false;
        return Run((world, token) => world.CreateSandboxAsync(request, token));
    }

    private async Task WipeAsync()
    {
        if (!_confirmWipe)
        {
            _confirmWipe = true;
            return;
        }

        _confirmWipe = false;
        await Run((world, token) => world.WipeAsync(token));
    }
}
