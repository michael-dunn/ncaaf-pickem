# Docker home-server environment file (P8-05).
#
# Copy to `.env` NEXT TO compose.yaml on the server and fill in every value:
#   cp .env.example .env && chmod 600 .env
# `.env` is gitignored and must never be committed. Docker Compose substitutes ${NAME} in
# compose.yaml from this file; nothing here is read by the application directly - compose.yaml
# maps each of these onto the ASP.NET Core key the app actually reads (`__` is the environment
# variable separator for a nested configuration key, e.g. App__PublicOrigin == App:PublicOrigin).
#
# No quoting: everything after the first `=` is the value, verbatim. Avoid `$` in passwords -
# compose treats it as the start of a variable reference (write `$$` if you must have one).

# --- SQL Server ---------------------------------------------------------------------------
# The sa password for the db container AND the one baked into the api's connection string.
# SQL Server rejects anything under 8 characters or missing three of upper/lower/digit/symbol.
SA_PASSWORD=<strong-sa-password>

# --- Public origin ------------------------------------------------------------------------
# The URL family members actually type, i.e. what `tailscale serve` publishes. Invite links
# (InviteResponse.Url) are built from it. No trailing slash.
PUBLIC_ORIGIN=https://<host>.<tailnet>.ts.net

# --- CollegeFootballData ------------------------------------------------------------------
# Free tier key. Reference data only; live scores come from ESPN with CFBD as fallback.
CFBD_API_KEY=<collegefootballdata-api-key>

# --- Web push (VAPID) ---------------------------------------------------------------------
# Generate ONCE and never change it - replacing the pair invalidates every stored subscription:
#   docker run --rm ghcr.io/michael-dunn/ncaaf-pickem:latest generate-vapid
# Subject must be a real mailto: or https: contact.
VAPID_PUBLIC=<vapid-public-key>
VAPID_PRIVATE=<vapid-private-key>
VAPID_SUBJECT=mailto:<real-contact-address>

# --- GHCR credentials for watchtower ------------------------------------------------------
# Only needed while the container package is PRIVATE. Because the repository is public the
# package can be made public too (GitHub -> Packages -> ncaaf-pickem -> Package settings ->
# Change visibility), after which watchtower pulls anonymously and these can be left empty.
# If you keep them, the PAT is a classic token with `read:packages` scope and nothing else.
GHCR_USER=<github-username>
GHCR_PAT=<github-pat-with-read-packages>

# --- Time zone ----------------------------------------------------------------------------
# The container's local time. Job schedules are Eastern regardless (SeasonCalendar resolves
# America/New_York by name), so this only affects log timestamps and the backup filename date.
TZ=America/Phoenix
