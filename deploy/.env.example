# Home server environment file. Copy to deploy/.env (gitignored - never commit the real file)
# and fill in every value. install-service.ps1 reads this file and writes each KEY=VALUE pair
# into the service's own environment (HKLM\SYSTEM\CurrentControlSet\Services\<name>\Environment),
# not the machine-wide environment, so it never leaks into other processes on the box.
#
# Every key mirrors Implementation/01-Architecture.md "Configuration" plus the deploy-only keys
# below. `__` is the ASP.NET Core environment-variable separator for a nested config key
# (e.g. Kestrel__Certificates__Default__Path == Kestrel:Certificates:Default:Path).
#
# Lines starting with # are comments. Blank lines are ignored. No quoting: everything after the
# first `=` is the value, verbatim (a Windows path with backslashes needs no escaping here).

# --- Host / runtime ---
ASPNETCORE_ENVIRONMENT=Production
# Kestrel binds from Kestrel__Certificates__Default below; ASPNETCORE_URLS just names the port.
# 8443 avoids needing SYSTEM-level reservation of 443; forward 443 -> 8443 on the router if you
# want the bare hostname, or run the service account with permission to bind 443 (netsh http add
# urlacl) and use 443 directly. Either way this must match App__PublicOrigin's port.
ASPNETCORE_URLS=https://0.0.0.0:8443

# --- Database ---
ConnectionStrings__Default=Server=localhost;Database=NcaafPickEm;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True
# D-015: false outside Development by default. deploy.ps1 runs migrations as an explicit step
# before restarting the service, so the app itself never migrates on startup here.
Database__MigrateOnStartup=false

# --- Tailscale HTTPS certificate (see README "Deploy - Tailscale HTTPS") ---
# `tailscale cert <host>.<tailnet>.ts.net` writes these two PEM files next to each other.
Kestrel__Certificates__Default__Path=C:\NcaafPickEm\cert\<host>.<tailnet>.ts.net.crt
Kestrel__Certificates__Default__KeyPath=C:\NcaafPickEm\cert\<host>.<tailnet>.ts.net.key

# --- Google OAuth (README "Google OAuth dev setup" - redirect URI below must be registered) ---
# Redirect URI to add in the Google Cloud console: https://<host>.<tailnet>.ts.net/auth/callback/google
Google__ClientId=<google-oauth-client-id>
Google__ClientSecret=<google-oauth-client-secret>

# --- Reference / live data providers ---
Cfbd__ApiKey=<collegefootballdata-api-key>
Providers__ReferenceData=Cfbd
Providers__LiveScores=Espn
# Optional (D-164). Unset = on when ReferenceData is Cfbd and Jobs__Enabled is true: the first
# start on an empty database fetches the calendar and the current week (~7 CFBD calls, once).
# Providers__BootstrapOnStartup=false

# --- Web push (VAPID) - generate once with deploy/generate-vapid.ps1, then never change it ---
Push__VapidPublicKey=<vapid-public-key>
Push__VapidPrivateKey=<vapid-private-key>
Push__Subject=mailto:<real-contact-address>

# --- Public origin - must match the Tailscale hostname and ASPNETCORE_URLS port; used to build
# invite links and must match the Google OAuth "Authorized JavaScript origin" ---
App__PublicOrigin=https://<host>.<tailnet>.ts.net:8443

# --- Jobs ---
Jobs__Enabled=true
Jobs__CatchUpMinutes=60

# --- Rate limiting (P8-01 / D-153) - fixed one-minute window per client IP on /auth/* and on
# /api/invites/{code}[/accept], the only routes reachable without an existing membership.
# Over the limit is 429 ProblemDetails with Retry-After. Leave Enabled true. ---
RateLimiting__Enabled=true
RateLimiting__AuthPermitPerMinute=30
RateLimiting__InvitePermitPerMinute=20

# --- Deploy-script-only settings (not read by the app; consumed by deploy/*.ps1 themselves) ---
# Used by backup.ps1 / restore-verify.ps1 / register-backup-task.ps1.
BACKUP_DATABASE_NAME=NcaafPickEm
BACKUP_FOLDER=C:\NcaafPickEm\backups
BACKUP_SQL_SERVER_INSTANCE=localhost
