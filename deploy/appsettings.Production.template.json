{
  "//": [
    "Template for the home server. Copy next to the published NcaafPickEm.Api.dll as",
    "appsettings.Production.json (gitignored) and fill in every placeholder, or supply the",
    "same keys as environment variables using __ as the separator",
    "(ConnectionStrings__Default, Google__ClientId, ...).",
    "NEVER commit a filled-in copy. P8-02 owns the deployment scripts."
  ],
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=NcaafPickEm;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Database": {
    "//": "D-013. False outside Development by default; the deploy script runs `dotnet ef database update` as an explicit step.",
    "MigrateOnStartup": false
  },
  "Google": {
    "ClientId": "<google-oauth-client-id>",
    "ClientSecret": "<google-oauth-client-secret>"
  },
  "Cfbd": {
    "ApiKey": "<collegefootballdata-api-key>"
  },
  "Providers": {
    "ReferenceData": "Cfbd",
    "LiveScores": "Espn"
  },
  "Push": {
    "VapidPublicKey": "<vapid-public-key>",
    "VapidPrivateKey": "<vapid-private-key>",
    "Subject": "mailto:commissioner@example.com"
  },
  "App": {
    "PublicOrigin": "https://<tailnet-host>"
  },
  "Jobs": {
    "Enabled": true
  }
}
