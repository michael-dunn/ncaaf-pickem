    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "http://localhost:5204",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "Providers__ReferenceData": "Fixture",
        "Providers__LiveScores": "Fixture"
      }
    },
    "simulator": {
      "commandName": "Project",
