<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Composition root: minimal endpoints, auth, job host, and static hosting of the Blazor WASM app. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- TimeZoneInfo.FindSystemTimeZoneById("America/New_York") needs ICU. Never set this to true. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <UserSecretsId>ncaaf-pickem-api</UserSecretsId>
    <!-- Hosting note (P0-04, D-024): a hosted Blazor WASM project's index.html keeps the SDK's
         `#[.{fingerprint}]` placeholders through the HOST's publish - the rewrite only happens
         when the Blazor project is published on its own. The Web project therefore references
         `_framework/blazor.webassembly.js` by its stable path and sets
         OverrideHtmlAssetPlaceholders=false. Do not reintroduce placeholders in index.html. -->

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NcaafPickEm.Infrastructure\NcaafPickEm.Infrastructure.csproj" />
    <ProjectReference Include="..\NcaafPickEm.Shared\NcaafPickEm.Shared.csproj" />
    <ProjectReference Include="..\NcaafPickEm.Web\NcaafPickEm.Web.csproj" />
  </ItemGroup>

</Project>
