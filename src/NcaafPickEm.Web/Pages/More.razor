@page "/more"
@inject AppShellState Shell

@*
    "More" tab (P0-04 placeholder, filled in by P1-03 and P2-04): a small menu to Profile and the
    commissioner Data status page. The link is shown to everyone; the page itself checks
    commissioner status server-side (the 403 from GET /api/admin/data-status) and shows a
    friendly message to anyone who is not one, rather than hiding the link client-side.
*@

<PageTitle>More - NCAAF Pick Em</PageTitle>

<h1>More</h1>

<div class="card">
    <h2>Account</h2>
    <ul class="more-menu">
        <li><a class="more-menu-item" href="/me">Profile &rsaquo;</a></li>
        <li><a class="more-menu-item" href="/admin/data">Data status &rsaquo;</a></li>
    </ul>
</div>

<div class="card">
    <h2>Time zone</h2>
    <p class="muted text-sm">
        Times are shown in your device time zone. Lock times also show the Eastern time the
        league runs on.
    </p>
    <p class="text-sm">
        This device: <strong>@_localZone</strong> &mdash; now @_localNow
    </p>
    <p class="placeholder-note">
        Placeholder from P0-04. Zone <em>abbreviations</em> ("MDT") must come from the browser's
        Intl API, not .NET: the client runs with invariant globalization (D-023).
    </p>
</div>

@code {
    private string _localZone = string.Empty;
    private string _localNow = string.Empty;

    protected override void OnInitialized()
    {
        Shell.ClearLeague();
        Shell.SetTitle("More");

        // Also a live check that the trimmed, invariant-globalization client still resolves the
        // browser's zone and renders local time (see DECISIONS D-023). Under invariant
        // globalization TimeZoneInfo has no friendly names, so show the offset.
        DateTimeOffset now = DateTimeOffset.Now;
        string sign = now.Offset < TimeSpan.Zero ? "-" : "+";
        _localZone = $"UTC{sign}{now.Offset.Duration():hh\\:mm}";
        _localNow = now.ToString("ddd h:mm tt");
    }
}
