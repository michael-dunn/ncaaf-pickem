@page "/login"

<PageTitle>Sign in</PageTitle>

<h1>Sign in through Tailscale</h1>

<p>
    This app knows you by your Tailscale account. Open it through the tailnet address
    (https://dunn-home-server.tail7d7633.ts.net:8443) and you are signed in automatically.
</p>

<p>
    If you can see this page, the request did not come through Tailscale, or your device is a
    tagged device with no user.
</p>

@code {
    /// <summary>
    /// Where the caller was headed before they were sent here. Unused since P9-03 - there is no
    /// sign-in step to come back from - but kept so <c>UnauthorizedRedirectHandler</c> and
    /// <c>Join.razor</c> can go on appending it.
    /// </summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }
}
