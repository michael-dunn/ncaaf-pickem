@page "/leagues/{LeagueId:guid}/config/week/{Week:int}"
@inject ILeaguesApi LeaguesApi
@inject IGameSetsApi GameSetsApi
@inject IPointRulesApi PointRulesApi
@inject ICorrectionsApi CorrectionsApi
@inject AppShellState Shell

@*
    This week's games (P3-05). Commissioner-only: the generated list with a remove (x) per game,
    "Add game" search over Saturday FBS candidates, and a tap-to-override point stepper per row.
    Every control is disabled once the week is locked (WeekGameSetResponse.IsLocked).

    P5-05: once the week is locked, a per-game "Correct" menu replaces the remove/edit-points
    actions: "Set result" (pick the winner, with a reason) and "Void game" (reason only). A
    voided game shows a "Voided" pill; an overridden game shows "Result set: <winner>". Both
    actions are commissioner-only and only reachable after lock, matching the server's 409
    NotLocked/AlreadyVoided rules (03-API-Contracts.md, Feature 06).
*@

<PageTitle>Week @Week games - NCAAF Pick Em</PageTitle>

<ErrorBanner Message="@_error" OnDismiss="() => _error = null" />

@if (_league is null || _set is null)
{
    <LoadingSkeleton Rows="4" />
}
else if (_league.MyRole != MembershipRole.Commissioner)
{
    <p class="muted">Commissioners only.</p>
}
else
{
    WeekGameSetResponse set = _set;

    <h1>Week @Week games</h1>

    <div class="card week-games-header">
        <LockTime LockAtUtc="set.LockAtUtc" EasternDisplay="@set.LockAtEasternDisplay" NoLockText="No games yet" />
        @if (set.IsLocked)
        {
            <span class="locked-pill">Locked</span>
        }
    </div>

    <div class="card">
        @if (set.Games.Length == 0)
        {
            <p class="muted">No games yet.</p>
        }
        else
        {
            @foreach (GameSetGameDto game in set.Games)
            {
                <GameRow Game="game">
                    <Trailing>
                        @if (set.IsLocked)
                        {
                            @if (game.IsVoided)
                            {
                                <span class="locked-pill">Voided</span>
                            }
                            else if (game.WinnerTeamId is { } winnerId)
                            {
                                <span class="locked-pill">Result set: @WinnerName(game, winnerId)</span>
                            }
                            else
                            {
                                <button type="button" class="btn btn-secondary" @onclick="() => OpenCorrectMenu(game)">
                                    Correct
                                </button>
                            }
                        }
                        else if (_overridingGameId == game.GameId)
                        {
                            <NumberStepper Value="game.PointValue"
                                           Disabled="set.IsLocked"
                                           ShowClear="true"
                                           ValueChanged="v => SetOverrideAsync(game.GameId, v)"
                                           OnClear="() => ClearOverrideAsync(game.GameId)" />
                        }
                        else
                        {
                            <div class="row-actions">
                                <button type="button" class="btn-link" disabled="@set.IsLocked" @onclick="() => _overridingGameId = game.GameId">
                                    Edit points
                                </button>
                                <button type="button" class="game-remove" aria-label="Remove game" disabled="@set.IsLocked" @onclick="() => ConfirmRemove(game)">
                                    &#10005;
                                </button>
                            </div>
                        }
                    </Trailing>
                </GameRow>
            }
        }
        <button type="button" class="btn btn-secondary rule-add-btn" disabled="@set.IsLocked" @onclick="OpenAddGameSheet">
            Add game
        </button>
    </div>
}

<ConfirmSheet IsOpen="_removeTarget is not null"
              Title="Remove game?"
              Body="@RemoveBody()"
              ConfirmLabel="Remove"
              IsDestructive="true"
              OnConfirm="RemoveConfirmedAsync"
              OnCancel="() => _removeTarget = null" />

<BottomSheet IsOpen="_showAddGame" Title="Add game" OnClose="() => _showAddGame = false">
    <div class="sheet-field">
        <label for="game-search">Search</label>
        <input id="game-search" class="input" type="search" placeholder="Search teams..." @bind="_gameSearchText" @bind:event="oninput" @bind:after="OnGameSearchInput" />
    </div>
    @foreach (GameCandidate candidate in _candidates)
    {
        <div class="search-result-row">
            <span>@candidate.AwayTeam.School @@ @candidate.HomeTeam.School</span>
            <button type="button" class="btn btn-secondary" @onclick="() => AddGameAsync(candidate.GameId)">Add</button>
        </div>
    }
</BottomSheet>

<BottomSheet IsOpen="_correctingGame is not null" Title="Correct game" OnClose="CloseCorrectMenu">
    @if (_correctingGame is { } correcting)
    {
        <p class="muted text-sm">@correcting.AwayTeam.School @@ @correcting.HomeTeam.School</p>
        <div class="row-actions correct-menu-actions">
            <button type="button" class="btn btn-secondary" @onclick="() => OpenSetResultSheet(correcting)">
                Set result
            </button>
            <button type="button" class="btn btn-danger" @onclick="() => OpenVoidSheet(correcting)">
                Void game
            </button>
        </div>
    }
</BottomSheet>

<BottomSheet IsOpen="_settingResultGame is not null" Title="Set result" OnClose="CloseSetResultSheet">
    @if (_settingResultGame is { } resultGame)
    {
        <p class="muted text-sm">Pick the winner of @resultGame.AwayTeam.School @@ @resultGame.HomeTeam.School.</p>
        <div class="result-team-choices">
            <TeamPickButton Team="resultGame.AwayTeam" Rank="resultGame.AwayRank"
                             IsSelected="_resultWinnerId == resultGame.AwayTeam.TeamId"
                             OnPick="() => _resultWinnerId = resultGame.AwayTeam.TeamId" />
            <TeamPickButton Team="resultGame.HomeTeam" Rank="resultGame.HomeRank"
                             IsSelected="_resultWinnerId == resultGame.HomeTeam.TeamId"
                             OnPick="() => _resultWinnerId = resultGame.HomeTeam.TeamId" />
        </div>
        <div class="sheet-field">
            <label for="result-reason">Reason</label>
            <input id="result-reason" class="input" maxlength="200" @bind="_resultReason" @bind:event="oninput" placeholder="Why is this being corrected?" />
        </div>
        <div class="profile-actions">
            <button type="button" class="btn btn-primary" disabled="@(!CanConfirmResult() || _correctionBusy)" @onclick="ConfirmSetResultAsync">
                @(_correctionBusy ? "Saving..." : "Confirm")
            </button>
            <button type="button" class="btn btn-secondary" @onclick="CloseSetResultSheet">Cancel</button>
        </div>
    }
</BottomSheet>

<BottomSheet IsOpen="_voidingGame is not null" Title="Void game" OnClose="CloseVoidSheet">
    @if (_voidingGame is { } voidGame)
    {
        <p class="muted text-sm">
            Voiding @voidGame.AwayTeam.School @@ @voidGame.HomeTeam.School excludes it from scoring for everyone.
        </p>
        <div class="sheet-field">
            <label for="void-reason">Reason</label>
            <input id="void-reason" class="input" maxlength="200" @bind="_voidReason" @bind:event="oninput" placeholder="Why is this being voided?" />
        </div>
        <div class="profile-actions">
            <button type="button" class="btn btn-danger" disabled="@(!CanConfirmVoid() || _correctionBusy)" @onclick="ConfirmVoidAsync">
                @(_correctionBusy ? "Voiding..." : "Void")
            </button>
            <button type="button" class="btn btn-secondary" @onclick="CloseVoidSheet">Cancel</button>
        </div>
    }
</BottomSheet>

@code {
    /// <summary>League from the route.</summary>
    [Parameter]
    public Guid LeagueId { get; set; }

    /// <summary>Week from the route.</summary>
    [Parameter]
    public int Week { get; set; }

    private LeagueDetail? _league;
    private WeekGameSetResponse? _set;
    private string? _error;
    private Guid? _overridingGameId;
    private GameSetGameDto? _removeTarget;

    private bool _showAddGame;
    private string _gameSearchText = string.Empty;
    private GameCandidate[] _candidates = [];
    private CancellationTokenSource? _searchDebounce;

    // P5-05: the "Correct" menu (set result / void), reachable only once the week is locked.
    private GameSetGameDto? _correctingGame;
    private GameSetGameDto? _settingResultGame;
    private Guid? _resultWinnerId;
    private string _resultReason = string.Empty;
    private GameSetGameDto? _voidingGame;
    private string _voidReason = string.Empty;
    private bool _correctionBusy;

    protected override async Task OnParametersSetAsync()
    {
        Shell.SetTitle($"Week {Week} games");
        _error = null;
        try
        {
            _league = await LeaguesApi.GetLeagueAsync(LeagueId);
            Shell.SetLeague(_league.LeagueId, _league.Name, Week);
            if (_league.MyRole != MembershipRole.Commissioner)
            {
                return;
            }

            _set = await GameSetsApi.GetWeekGameSetAsync(LeagueId, Week);
        }
        catch (LeaguesApiException ex)
        {
            _error = ex.Message;
        }
    }

    private void ConfirmRemove(GameSetGameDto game) => _removeTarget = game;

    private string RemoveBody() => _removeTarget is { } g
        ? $"Remove {g.AwayTeam.School} @ {g.HomeTeam.School} from week {Week}?"
        : string.Empty;

    private async Task RemoveConfirmedAsync()
    {
        if (_removeTarget is not { } game)
        {
            return;
        }

        _removeTarget = null;
        try
        {
            _set = await GameSetsApi.RemoveGameAsync(LeagueId, Week, game.GameId);
        }
        catch (LeaguesApiException ex)
        {
            _error = ex.Message;
        }
    }

    private void OpenAddGameSheet()
    {
        _gameSearchText = string.Empty;
        _candidates = [];
        _showAddGame = true;
        _ = LoadCandidatesAsync(string.Empty);
    }

    private void OnGameSearchInput()
    {
        _searchDebounce?.Cancel();
        var cts = new CancellationTokenSource();
        _searchDebounce = cts;
        _ = DebouncedLoadCandidatesAsync(_gameSearchText, cts.Token);
    }

    private async Task DebouncedLoadCandidatesAsync(string query, CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(300, cancellationToken);
            await LoadCandidatesAsync(query, cancellationToken);
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
            // Superseded by a newer keystroke.
        }
    }

    private async Task LoadCandidatesAsync(string query, CancellationToken cancellationToken = default)
    {
        if (_league is null)
        {
            return;
        }

        try
        {
            _candidates = await GameSetsApi.SearchCandidatesAsync(_league.SeasonYear, Week, query, cancellationToken);
        }
        catch (LeaguesApiException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task AddGameAsync(Guid gameId)
    {
        try
        {
            _set = await GameSetsApi.AddGameAsync(LeagueId, Week, gameId);
            _showAddGame = false;
        }
        catch (LeaguesApiException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task SetOverrideAsync(Guid gameId, int value)
    {
        try
        {
            _set = await PointRulesApi.SetOverrideAsync(LeagueId, Week, gameId, value);
        }
        catch (LeaguesApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _overridingGameId = null;
        }
    }

    private async Task ClearOverrideAsync(Guid gameId)
    {
        try
        {
            _set = await PointRulesApi.SetOverrideAsync(LeagueId, Week, gameId, null);
        }
        catch (LeaguesApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _overridingGameId = null;
        }
    }

    private static string WinnerName(GameSetGameDto game, Guid winnerId) =>
        winnerId == game.HomeTeam.TeamId ? game.HomeTeam.School : game.AwayTeam.School;

    private void OpenCorrectMenu(GameSetGameDto game) => _correctingGame = game;

    private void CloseCorrectMenu() => _correctingGame = null;

    private void OpenSetResultSheet(GameSetGameDto game)
    {
        _correctingGame = null;
        _settingResultGame = game;
        _resultWinnerId = null;
        _resultReason = string.Empty;
    }

    private void CloseSetResultSheet()
    {
        _settingResultGame = null;
        _resultWinnerId = null;
        _resultReason = string.Empty;
    }

    private void OpenVoidSheet(GameSetGameDto game)
    {
        _correctingGame = null;
        _voidingGame = game;
        _voidReason = string.Empty;
    }

    private void CloseVoidSheet()
    {
        _voidingGame = null;
        _voidReason = string.Empty;
    }

    private bool CanConfirmResult() =>
        _resultWinnerId is not null && _resultReason.Trim().Length is > 0 and <= 200;

    private bool CanConfirmVoid() => _voidReason.Trim().Length is > 0 and <= 200;

    private async Task ConfirmSetResultAsync()
    {
        if (_settingResultGame is not { } game || _resultWinnerId is not { } winnerId || !CanConfirmResult())
        {
            return;
        }

        _correctionBusy = true;
        try
        {
            await CorrectionsApi.OverrideResultAsync(LeagueId, Week, game.GameId, winnerId, _resultReason.Trim());
            _set = await GameSetsApi.GetWeekGameSetAsync(LeagueId, Week);
            CloseSetResultSheet();
        }
        catch (LeaguesApiException ex)
        {
            _error = FriendlyCorrectionMessage(ex);
        }
        finally
        {
            _correctionBusy = false;
        }
    }

    private async Task ConfirmVoidAsync()
    {
        if (_voidingGame is not { } game || !CanConfirmVoid())
        {
            return;
        }

        _correctionBusy = true;
        try
        {
            await CorrectionsApi.VoidGameAsync(LeagueId, Week, game.GameId, _voidReason.Trim());
            _set = await GameSetsApi.GetWeekGameSetAsync(LeagueId, Week);
            CloseVoidSheet();
        }
        catch (LeaguesApiException ex)
        {
            _error = FriendlyCorrectionMessage(ex);
        }
        finally
        {
            _correctionBusy = false;
        }
    }

    // Translates the ProblemDetails titles named in 03-API-Contracts.md's corrections routes
    // into messages a commissioner can act on, rather than showing the raw title.
    private static string FriendlyCorrectionMessage(LeaguesApiException ex) => ex.Message switch
    {
        "NotLocked" => "This week isn't locked yet, so it can't be corrected.",
        "AlreadyVoided" => "This game has already been voided.",
        "TeamNotInGame" => "That team isn't playing in this game.",
        "GameNotFound" => "That game is no longer in this week's set.",
        _ => ex.Message,
    };
}
