@page "/join/{Code}"
@inject ILeaguesApi LeaguesApi
@inject AppShellState Shell
@inject NavigationManager Navigation

@*
    Join (P1-02). Preview card and Join button for a link opened from a text message; the
    six-digit code (P9-05) also joins straight from the home page's join-by-code box, which does
    not use this page. State-specific copy comes from the shared InviteStateMessage component
    (P9-05), with a "Back to home" link on every non-Valid state. A 401 here is handled by
    UnauthorizedRedirectHandler, which sends the caller to /login?returnUrl=/join/{code} and back.
*@

<PageTitle>Join a league - NCAAF Pick Em</PageTitle>

<ErrorBanner Message="@_error" />

@if (_preview is null && _error is null)
{
    <LoadingSkeleton Rows="2" />
}
else if (_preview is { } preview)
{
    <div class="card join-card">
        <h1>@preview.LeagueName</h1>
        <p class="muted">Season @preview.SeasonYear &middot; @preview.MemberCount member@(preview.MemberCount == 1 ? "" : "s")</p>

        @switch (preview.State)
        {
            case InviteState.Valid:
                <p>You're invited to join this league.</p>
                <button type="button" class="btn btn-primary" @onclick="JoinAsync" disabled="@_joining">
                    @(_joining ? "Joining..." : "Join league")
                </button>
                break;

            case InviteState.AlreadyMember:
                <InviteStateMessage State="preview.State" />
                <a class="btn btn-primary" href="@ExistingLeagueHref">Go to league</a>
                <a class="btn btn-secondary" href="/">Back to home</a>
                break;

            default:
                <InviteStateMessage State="preview.State" />
                <a class="btn btn-secondary" href="/">Back to home</a>
                break;
        }
    </div>
}

@code {
    /// <summary>Invite code from the route.</summary>
    [Parameter]
    public string Code { get; set; } = string.Empty;

    private InvitePreview? _preview;
    private bool _joining;
    private string? _error;

    // AlreadyMember has no league id in InvitePreview; the acceptance response would carry it,
    // but for an already-joined caller the safest link back is the league picker, which lists
    // every league they belong to.
    private const string ExistingLeagueHref = "/";

    protected override async Task OnParametersSetAsync()
    {
        Shell.ClearLeague();
        Shell.SetTitle("Join a league");
        try
        {
            _preview = await LeaguesApi.GetInvitePreviewAsync(Code);
        }
        catch (LeaguesApiException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task JoinAsync()
    {
        _joining = true;
        try
        {
            InviteAcceptOutcome outcome = await LeaguesApi.AcceptInviteAsync(Code);
            if (outcome.League is { } league)
            {
                Navigation.NavigateTo($"/leagues/{league.LeagueId}");
                return;
            }

            _preview = outcome.Preview;
        }
        catch (LeaguesApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _joining = false;
        }
    }
}
