@page "/"
@inject AppShellState Shell

@*
    PLACEHOLDER (P0-04). Exists only so the shell has a route to render and the tab bar has
    somewhere to fall back to. P1-02 replaces this with the real "my leagues" screen
    (league list, create league, accept invite).
*@

<PageTitle>NCAAF Pick Em</PageTitle>

<h1>Welcome</h1>

<div class="card">
    <h2>Your leagues</h2>
    <p class="muted">
        Leagues you belong to will appear here, each with the current week and whether your picks
        are in.
    </p>
    <p class="placeholder-note">
        Placeholder screen from P0-04 (app shell). P1-02 replaces it with the real league list.
    </p>
</div>

<div class="card">
    <h2>Add to your home screen</h2>
    <p class="muted text-sm">
        On iPhone, open this page in Safari, tap Share, then <strong>Add to Home Screen</strong>.
        The app then opens full screen with no browser chrome.
    </p>
</div>

@code {
    protected override void OnInitialized()
    {
        // No league in context on the home screen: the tab bar collapses back to this route.
        Shell.ClearLeague();
        Shell.SetTitle("Home");
    }
}
