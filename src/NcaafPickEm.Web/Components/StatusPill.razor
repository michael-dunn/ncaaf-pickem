@* A member's SubmissionStatus as a small colored pill. Null (no game set yet) renders nothing
   visible; callers that need a message for that case show one themselves (05-Conventions.md
   naming glossary: Submission). Passing PickedCount/TotalCount (P4-03) renders "In Progress n of
   m" instead of the bare label while InProgress; ignored for every other status. *@

@if (Status is { } status)
{
    <span class="status-pill @CssClass(status)">@Label(status)</span>
}

@code {
    /// <summary>The status to render, or null when the week has no game set yet.</summary>
    [Parameter]
    public SubmissionStatus? Status { get; set; }

    /// <summary>Picks made so far; shown with <see cref="TotalCount"/> only while <see cref="SubmissionStatus.InProgress"/>.</summary>
    [Parameter]
    public int? PickedCount { get; set; }

    /// <summary>Active games in the set; shown with <see cref="PickedCount"/> only while <see cref="SubmissionStatus.InProgress"/>.</summary>
    [Parameter]
    public int? TotalCount { get; set; }

    private string Label(SubmissionStatus status) => status switch
    {
        SubmissionStatus.NotStarted => "Not Started",
        SubmissionStatus.InProgress => PickedCount is { } picked && TotalCount is { } total
            ? $"In Progress {picked} of {total}"
            : "In Progress",
        SubmissionStatus.Submitted => "Submitted",
        SubmissionStatus.Locked => "Locked",
        SubmissionStatus.Incomplete => "Incomplete",
        _ => status.ToString(),
    };

    private static string CssClass(SubmissionStatus status) => status switch
    {
        SubmissionStatus.NotStarted => "status-pill-neutral",
        SubmissionStatus.InProgress => "status-pill-warning",
        SubmissionStatus.Submitted => "status-pill-success",
        SubmissionStatus.Locked => "status-pill-brand",
        SubmissionStatus.Incomplete => "status-pill-danger",
        _ => "status-pill-neutral",
    };
}
