@* Renders a lock instant in the device's local time zone, with the server's Eastern rendering as
   a hint underneath. Shared by Phase 1 (league home), Phase 4 (picks), and Phase 6 (dashboard)
   per the P1-02 task card; the client cannot produce a zone abbreviation itself (D-023), so the
   Eastern string always comes from the server's LockAtEasternDisplay.

   ShowCountdown (P6-03) adds a ticking "Locks in ..." line for the pre-lock dashboard, reusing
   this component rather than a second one per D-045/the P6-03 task card - the local+Eastern
   rendering above is unchanged either way. *@
@implements IDisposable

@if (LockAtUtc is { } utc)
{
    <span class="lock-time">
        <span class="lock-time-local">@FormatLocal(utc)</span>
        @if (!string.IsNullOrWhiteSpace(EasternDisplay))
        {
            <span class="lock-time-eastern text-sm muted">(@EasternDisplay)</span>
        }
    </span>
    @if (ShowCountdown)
    {
        <div class="lock-time-countdown">@FormatCountdown(utc)</div>
    }
}
else if (!string.IsNullOrWhiteSpace(NoLockText))
{
    <span class="lock-time-none muted">@NoLockText</span>
}

@code {
    private Timer? _timer;

    /// <summary>Lock instant in UTC, or null when the week has no game set yet.</summary>
    [Parameter]
    public DateTimeOffset? LockAtUtc { get; set; }

    /// <summary>The server's Eastern rendering, e.g. "Sat 12:00 PM ET".</summary>
    [Parameter]
    public string? EasternDisplay { get; set; }

    /// <summary>Text shown instead when <see cref="LockAtUtc"/> is null.</summary>
    [Parameter]
    public string? NoLockText { get; set; }

    /// <summary>
    /// When true and <see cref="LockAtUtc"/> is set, also renders a "Locks in ..." countdown
    /// that ticks once a second. Default false (every other caller keeps the plain rendering).
    /// </summary>
    [Parameter]
    public bool ShowCountdown { get; set; }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (ShowCountdown && LockAtUtc is not null && _timer is null)
        {
            _timer = new Timer(_ => InvokeAsync(StateHasChanged), null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
        }
        else if (!ShowCountdown && _timer is not null)
        {
            _timer.Dispose();
            _timer = null;
        }
    }

    private static string FormatLocal(DateTimeOffset utc) => utc.ToLocalTime().ToString("ddd MMM d, h:mm tt");

    private static string FormatCountdown(DateTimeOffset utc)
    {
        TimeSpan remaining = utc - DateTimeOffset.UtcNow;
        if (remaining <= TimeSpan.Zero)
        {
            return "Locking now";
        }

        int days = remaining.Days;
        int hours = remaining.Hours;
        int minutes = remaining.Minutes;
        int seconds = remaining.Seconds;

        string body = days > 0
            ? $"{days}d {hours}h {minutes}m"
            : hours > 0
                ? $"{hours}h {minutes}m {seconds}s"
                : $"{minutes}m {seconds}s";

        return $"Locks in {body}";
    }

    /// <inheritdoc />
    public void Dispose()
    {
        _timer?.Dispose();
        _timer = null;
    }
}
