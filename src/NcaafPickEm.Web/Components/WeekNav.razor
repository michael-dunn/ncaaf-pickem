@* Week navigation for the leaderboard Week and Grid pages (P5-04): prev/next chips limited to
   weeks with a generated game set (LeagueWeek.HasGameSet), plus a jump to the league's display
   week. Only weeks that have had a game set generated are navigable (07-Leaderboard.txt). *@

<nav class="week-nav" aria-label="Week navigation">
    <button
        type="button"
        class="week-nav-chip"
        disabled="@(!CanGoTo(Week - 1))"
        aria-label="Previous week"
        @onclick="() => Go(Week - 1)">
        &lsaquo; Wk @(Week - 1)
    </button>

    <span class="week-nav-current">Week @Week</span>

    <button
        type="button"
        class="week-nav-chip"
        disabled="@(!CanGoTo(Week + 1))"
        aria-label="Next week"
        @onclick="() => Go(Week + 1)">
        Wk @(Week + 1) &rsaquo;
    </button>

    @if (DisplayWeek is { } displayWeek && displayWeek != Week)
    {
        <button type="button" class="btn btn-secondary week-nav-jump" @onclick="() => Go(displayWeek)">
            This week
        </button>
    }
</nav>

@code {
    /// <summary>The week currently being viewed.</summary>
    [Parameter, EditorRequired]
    public int Week { get; set; }

    /// <summary>Every week in the league's range, from <c>GET /api/leagues/{leagueId}/weeks</c>.</summary>
    [Parameter, EditorRequired]
    public LeagueWeek[] Weeks { get; set; } = [];

    /// <summary>Raised with the target week when a chip is tapped.</summary>
    [Parameter, EditorRequired]
    public EventCallback<int> OnNavigate { get; set; }

    // The display week (Feature 15): the week just played until the next week's picks open.
    private int? DisplayWeek => Weeks.FirstOrDefault(w => w.IsDisplayWeek)?.Week;

    private bool CanGoTo(int week) => Weeks.Any(w => w.Week == week && w.HasGameSet);

    private Task Go(int week) => OnNavigate.InvokeAsync(week);
}
