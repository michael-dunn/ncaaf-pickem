@using System.Net.Http.Headers
@inject HttpClient Http
@inject NavigationManager Navigation

<button type="button" class="logout" disabled="@_busy" @onclick="SignOutAsync">
    @(_busy ? "Signing out…" : "Sign out")
</button>

@code {
    // P0-04 adds a delegating handler that puts this header on every mutating call. Until then the
    // one mutation the client makes sets it inline.
    private const string CsrfHeaderName = "X-Requested-With";
    private const string CsrfHeaderValue = "NcaafPickEm";

    private bool _busy;

    private async Task SignOutAsync()
    {
        _busy = true;

        using var request = new HttpRequestMessage(HttpMethod.Post, "auth/logout");
        request.Headers.Add(CsrfHeaderName, CsrfHeaderValue);

        try
        {
            using HttpResponseMessage response = await Http.SendAsync(request);
        }
        catch (HttpRequestException)
        {
            // Offline: the cookie is still on the device, so fall through to the reload and let
            // the next /api/me decide. Nothing here is worth blocking the user on.
        }

        // Full reload: the auth cookie is HttpOnly, so only a fresh boot re-reads the real state.
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
