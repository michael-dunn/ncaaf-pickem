@* Tap-only numeric stepper (minus / value / plus), used for point values (1..100). Optional
   Clear button for "remove this override and fall back to the rule/default". *@

<div class="number-stepper">
    <button type="button" class="stepper-btn" disabled="@(Disabled || Value <= Min)" @onclick="Decrement" aria-label="Decrease">&#8722;</button>
    <span class="stepper-value">@Value</span>
    <button type="button" class="stepper-btn" disabled="@(Disabled || Value >= Max)" @onclick="Increment" aria-label="Increase">&#43;</button>
    @if (ShowClear)
    {
        <button type="button" class="stepper-clear" disabled="@Disabled" @onclick="Clear">Clear</button>
    }
</div>

@code {
    /// <summary>Current value.</summary>
    [Parameter]
    public int Value { get; set; }

    /// <summary>Raised when the value changes by a tap.</summary>
    [Parameter]
    public EventCallback<int> ValueChanged { get; set; }

    /// <summary>Minimum value, inclusive. Default 1.</summary>
    [Parameter]
    public int Min { get; set; } = 1;

    /// <summary>Maximum value, inclusive. Default 100.</summary>
    [Parameter]
    public int Max { get; set; } = 100;

    /// <summary>Disables every control (e.g. a locked week).</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Shows a "Clear" button (e.g. clearing a manual point override).</summary>
    [Parameter]
    public bool ShowClear { get; set; }

    /// <summary>Raised when Clear is tapped.</summary>
    [Parameter]
    public EventCallback OnClear { get; set; }

    private Task Decrement() => SetValue(Value - 1);

    private Task Increment() => SetValue(Value + 1);

    private Task SetValue(int value) => ValueChanged.InvokeAsync(Math.Clamp(value, Min, Max));

    private Task Clear() => OnClear.InvokeAsync();
}
