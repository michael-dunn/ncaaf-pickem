@inherits LayoutComponentBase
@implements IDisposable
@inject AppShellState Shell

<CascadingValue Value="Shell" IsFixed="true">
    <div class="app-shell">
        <header class="top-bar">
            <div class="top-bar-inner">
                <span class="top-bar-title">@Shell.HeaderText</span>
                @if (!string.IsNullOrEmpty(Shell.Title) && Shell.Title != Shell.HeaderText)
                {
                    <span class="top-bar-subtitle">@Shell.Title</span>
                }
            </div>
        </header>

        <main class="app-main">
            @Body
        </main>

        <BottomTabBar />
    </div>
</CascadingValue>

@code {
    protected override void OnInitialized() => Shell.Changed += OnShellChanged;

    private void OnShellChanged() => StateHasChanged();

    /// <inheritdoc />
    public void Dispose() => Shell.Changed -= OnShellChanged;
}
