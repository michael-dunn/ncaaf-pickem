<Project Sdk="Microsoft.NET.Sdk">

  <!-- EF Core DbContext, migrations, repositories, providers, push, jobs. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cron parsing and time-zone-aware occurrence enumeration for the job scheduler (D-005). -->
    <PackageReference Include="Cronos" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- Design is a full (not private) reference so AppDbContextFactory can implement
         IDesignTimeDbContextFactory<AppDbContext> and `dotnet ef` can load it from the build
         output of either this project or the Api startup project. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NcaafPickEm.Domain\NcaafPickEm.Domain.csproj" />
    <ProjectReference Include="..\NcaafPickEm.Shared\NcaafPickEm.Shared.csproj" />
  </ItemGroup>

</Project>
