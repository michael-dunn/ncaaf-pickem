<Project Sdk="Microsoft.NET.Sdk">

  <!-- EF Core DbContext, migrations, repositories, providers, push, jobs. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- Design is a full (not private) reference so AppDbContextFactory can implement
         IDesignTimeDbContextFactory<AppDbContext> and `dotnet ef` can load it from the build
         output of either this project or the Api startup project. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NcaafPickEm.Domain\NcaafPickEm.Domain.csproj" />
    <ProjectReference Include="..\NcaafPickEm.Shared\NcaafPickEm.Shared.csproj" />
    <!-- P2-05 (see DECISIONS.md): the fixture providers read their JSON from the embedded
         resources in tests/NcaafPickEm.Fixtures, so Infrastructure takes a project reference on
         what is otherwise a test-only classlib. It is a few hundred KB of embedded JSON plus a
         loader with no test framework dependency, and P8-03's Simulate page needs it server-side
         too, so this is not a test-into-production layering violation in practice. -->
    <ProjectReference Include="..\..\tests\NcaafPickEm.Fixtures\NcaafPickEm.Fixtures.csproj" />
  </ItemGroup>

</Project>
