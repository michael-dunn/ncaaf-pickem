<Project Sdk="Microsoft.NET.Sdk">

  <!--
    JSON fixtures (sample CFBD/ESPN payloads, the full sample week) plus a loader.
    Every *.json under Data/ is embedded, so consumers need no file copying.
    P2-05 fills Data/ with the Week 7, 2026 sample week.

    Real/ holds trimmed captures of real provider responses (P2-01): documentation for the field
    mappings in Implementation/spikes/providers.md, and since P2-03 also inputs - the ESPN parser
    is tested against the captured scoreboards, and TeamAliasSeed reads team-aliases-draft.json at
    runtime. They are embedded under their own resource prefix and read with
    FixtureLoader.ReadRealText, so FixtureLoader.Names still lists only the synthetic sample week
    in Data/ and no test payload is duplicated into it.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\**\*.json" />
    <EmbeddedResource Include="Real\**\*.json" />
  </ItemGroup>

</Project>
