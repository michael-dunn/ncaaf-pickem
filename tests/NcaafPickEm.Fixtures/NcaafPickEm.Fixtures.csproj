<Project Sdk="Microsoft.NET.Sdk">

  <!--
    JSON fixtures (sample CFBD/ESPN payloads, the full sample week) plus a loader.
    Every *.json under Data/ is embedded, so consumers need no file copying.
    P2-05 fills Data/ with the Week 7, 2026 sample week.

    Real/ is deliberately OUTSIDE the embedding glob. It holds trimmed captures of real
    provider responses (P2-01) that exist as documentation for the field mappings in
    Implementation/spikes/providers.md, not as test inputs. Keeping them out of Data/ keeps
    FixtureLoader.Names (and the ScaffoldTests assertion that it is empty until P2-05) intact.
    If a later task wants to load one of these in a test, copy it under Data/ rather than
    widening the glob.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\**\*.json" />
  </ItemGroup>

</Project>
