<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure unit tests. No database, no network. Must finish in under 10 seconds. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NcaafPickEm.Domain\NcaafPickEm.Domain.csproj" />
    <!-- P2-05: the fixture providers have no database or network access, so their tests belong
         here alongside the rest of the pure Domain suite rather than in Api.Tests. -->
    <ProjectReference Include="..\..\src\NcaafPickEm.Infrastructure\NcaafPickEm.Infrastructure.csproj" />
    <ProjectReference Include="..\NcaafPickEm.Fixtures\NcaafPickEm.Fixtures.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>

</Project>
